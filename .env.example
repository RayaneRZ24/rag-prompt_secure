# Copie ce fichier en ".env" (même dossier) et remplis les valeurs réelles.
# Le fichier ".env" est ignoré par git (.gitignore) — ne jamais commiter de vraies clés.

# ── Couche 2 : LlamaFirewall (PromptGuard2 ML) ────────────────────────────────
# Token HuggingFace avec accès accepté à meta-llama/Llama-Prompt-Guard-2-86M.
# Sans cette variable (ou si l'accès au modèle n'est pas accepté sur ton compte
# HuggingFace), input_guard.py bascule automatiquement en fallback regex.
HF_TOKEN=

# ── JWT (optionnel — a une valeur par défaut de dev dans config.py) ──────────
# JWT_SECRET_KEY=

# ── Qdrant (optionnel — valeurs par défaut : localhost:6333) ─────────────────
# QDRANT_HOST=
# QDRANT_PORT=

# ── Ollama (optionnel — valeurs par défaut : localhost:11434, llama3.1:8b) ───
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# ── Scripts de test (tests/test_security_layers.py, garak_rag_api_generator.py)
# Mot de passe du compte de démo "admin" (voir FAKE_USERS_DB dans config.py) —
# nécessaire uniquement pour lancer ces scripts, pas pour l'app elle-même.
DEMO_ADMIN_PASSWORD=
